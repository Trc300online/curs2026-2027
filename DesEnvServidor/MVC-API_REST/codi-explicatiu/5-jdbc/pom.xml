<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dwes.patrons</groupId>
        <artifactId>codi-explicatiu</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>5-jdbc</artifactId>
    <packaging>war</packaging>
    <name>5 JDBC i DAO</name>
    <description>Les dades a MySQL: JDBC, transaccions i el patró DAO, sense tocar ni els Servlets ni les vistes</description>

    <dependencies>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>

        <!-- JSTL: Tomcat no la porta, va dins el .war -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
        </dependency>

        <!-- El controlador JDBC: la part que sap parlar amb MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- target/jdbc.war → http://localhost:8080/jdbc/ -->
        <finalName>jdbc</finalName>
    </build>
</project>
