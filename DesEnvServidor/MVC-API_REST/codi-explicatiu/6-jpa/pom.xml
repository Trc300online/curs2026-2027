<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dwes.patrons</groupId>
        <artifactId>codi-explicatiu</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>6-jpa</artifactId>
    <packaging>war</packaging>
    <name>6 JPA</name>
    <description>Les mateixes taules i els mateixos DAO, ara amb JPA: classes anotades, i el SQL el genera Hibernate</description>

    <dependencies>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>

        <!-- JSTL: Tomcat no la porta, va dins el .war -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
        </dependency>

        <!-- JPA és l'especificació, i Hibernate la implementa. Tomcat no du cap de les dues: van dins el .war -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>

        <!-- Per davall, Hibernate continua usant JDBC -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- target/jpa.war → http://localhost:8080/jpa/ -->
        <finalName>jpa</finalName>
    </build>
</project>
